# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source GIFs for the hero animations — working files, not shipped. They are
# huge (knot0last is 289 MB) and git cannot shrink a repo once they are in its
# history. What actually gets served is the converted H.264/WebM in public/hero,
# which stays tracked. Keep new sources here and convert with, e.g.:
#   ffmpeg -i "in.gif" -c:v libx264 -crf 30 -preset slow -pix_fmt yuv420p \
#          -movflags +faststart -an public/hero/out.mp4
components/assets/GIF/
